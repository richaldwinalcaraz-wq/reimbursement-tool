PORT=3001

# Optional bootstrap default — you can also paste this into Settings in the
# app instead. Whichever is entered in Settings takes over from then on
# (persisted to DATA_DIR/app-settings.json, not this file).
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Where uploaded files, generated exports, and saved app settings live.
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
DATA_DIR=./data
MAX_FILE_SIZE_MB=50

# Note: email delivery goes through the HubSpot Transactional Email API
# (see backend/src/services/emailService.ts), not SMTP — there is no SMTP
# configuration in this app.
